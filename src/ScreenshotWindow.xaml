<Window x:Class="PixOcrSearch.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Modern flat buttons using DynamicResource -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#1084E3"/>
                                <Setter TargetName="pBorder" Property="BorderBrush" Value="#0078D7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="pBorder" Property="BorderBrush" Value="#004578"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Mini Button with CornerRadius="3" -->
        <Style x:Key="PillMiniButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                <Setter TargetName="pBorder" Property="BorderBrush" Value="#AAAAAA"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Delete Button with CornerRadius="3" and Red Text -->
        <Style x:Key="PillDeleteButton" TargetType="Button" BasedOn="{StaticResource PillMiniButton}">
            <Setter Property="Foreground" Value="#E05252"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="dBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                <Setter TargetName="dBorder" Property="BorderBrush" Value="#E05252"/>
                                <Setter Property="Foreground" Value="#FF3333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="dBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <!-- The background screen image -->
        <Image x:Name="BackgroundImg" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Hollow-out dark overlay -->
        <Path Fill="#50000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="ScreenGeometry" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <GeometryGroup x:Name="HollowGroup" FillRule="Nonzero">
                            <RectangleGeometry x:Name="SelectionGeometry" Rect="0,0,0,0" />
                        </GeometryGroup>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- Deep Blue Crosshair Guides -->
        <Line x:Name="CrosshairH" X1="0" Y1="0" X2="0" Y2="0" Stroke="#005FB8" StrokeThickness="1" SnapsToDevicePixels="True" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.85"/>
        <Line x:Name="CrosshairV" X1="0" Y1="0" X2="0" Y2="0" Stroke="#005FB8" StrokeThickness="1" SnapsToDevicePixels="True" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.85"/>

        <!-- Selection border, multi-region tags, and floating action toolbar -->
        <Canvas x:Name="OverlayCanvas" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Canvas for committed regions (boxes, badges, reorder buttons, delete buttons) -->
            <Canvas x:Name="CommittedRegionsCanvas" IsHitTestVisible="True" SnapsToDevicePixels="True" />

            <!-- Active Dragging Border -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="#0078D7"
                    BorderThickness="1.5"
                    Visibility="Collapsed"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True">
            </Border>

            <!-- Sizing label -->
            <Border x:Name="SizeLabelBorder"
                    Background="{DynamicResource ThemeWindowBg}"
                    BorderBrush="{DynamicResource ThemeWindowBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4,2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True">
                <TextBlock x:Name="SizeTextBlock"
                           Foreground="{DynamicResource ThemeText}"
                           FontSize="10"
                           FontFamily="Microsoft YaHei UI, Segoe UI" />
            </Border>

            <!-- Floating Action Bar for Multi-region Confirmation (Draggable) -->
            <Grid x:Name="FloatingActionBar" 
                  Visibility="Collapsed" 
                  SnapsToDevicePixels="True" 
                  UseLayoutRounding="True"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="FloatingActionBar_MouseLeftButtonDown"
                  MouseMove="FloatingActionBar_MouseMove"
                  MouseUp="FloatingActionBar_MouseUp">
                <!-- Separate Shadow Border to prevent bitmap rasterization blur -->
                <Border Background="{DynamicResource ThemeWindowBg}" CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>
                </Border>

                <!-- Sharp Content Border -->
                <Border Background="{DynamicResource ThemeWindowBg}"
                        BorderBrush="{DynamicResource ThemeWindowBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,5"
                        SnapsToDevicePixels="True"
                        RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Drag Handle Icon -->
                        <TextBlock Text="⋮⋮" 
                                   Foreground="{DynamicResource ThemeSubText}" 
                                   FontSize="12" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center" 
                                   Margin="2,0,8,0" 
                                   ToolTip="按住可拖动工具栏"/>

                        <!-- Count Badge -->
                        <Border Background="{DynamicResource ThemeInputBg}" 
                                BorderBrush="{DynamicResource ThemeInputBorder}"
                                BorderThickness="1"
                                CornerRadius="4" 
                                Padding="7,3" 
                                Margin="0,0,8,0" 
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="CountBadgeTextBlock"
                                       Text="已框选 1 处"
                                       Foreground="{DynamicResource ThemeSubText}"
                                       FontSize="11.5"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Undo Button -->
                        <Button x:Name="UndoButton"
                                Content="撤销"
                                Style="{StaticResource ModernButton}"
                                Click="UndoButton_Click"
                                Margin="0,0,6,0"
                                ToolTip="撤销删除或调序操作 (Ctrl+Z)"/>

                        <!-- Done Button -->
                        <Button x:Name="DoneButton"
                                Content="完成"
                                Style="{StaticResource PrimaryButton}"
                                Click="DoneButton_Click"
                                Margin="0,0,6,0"/>

                        <!-- Insert Button (Visible when _initialRegionOffset > 0) -->
                        <Button x:Name="InsertButton"
                                Content="插入"
                                Style="{StaticResource ModernButton}"
                                Click="InsertButton_Click"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"
                                ToolTip="打开已框选抽屉，调整前后插入顺序"/>

                        <!-- Switch Window Button -->
                        <Button x:Name="SwitchWindowButton"
                                Content="切换界面"
                                Style="{StaticResource ModernButton}"
                                Click="SwitchWindowButton_Click"
                                Margin="0,0,6,0"/>

                        <!-- Cancel Button -->
                        <Button x:Name="CancelOcrButton"
                                Content="✕ 取消"
                                Click="CancelOcrButton_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource ThemeSubText}"
                                BorderThickness="0"
                                Padding="8,4"
                                FontSize="12"
                                FontFamily="Microsoft YaHei UI, Segoe UI"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="cancelBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cancelBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</Window>
