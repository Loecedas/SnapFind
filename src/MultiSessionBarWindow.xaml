<Window x:Class="PixOcrSearch.MultiSessionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapFind 连续框选暂存"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Modern flat buttons using DynamicResource -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#E05252"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E05252"/>
                                <Setter Property="Foreground" Value="#FF3333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#1084E3"/>
                                <Setter TargetName="pBorder" Property="BorderBrush" Value="#0078D7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="pBorder" Property="BorderBrush" Value="#004578"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggleButton" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tbBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tbBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="#AAAAAA"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tbBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="{DynamicResource ThemeWindowBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <!-- Separate Shadow Layer -->
        <Border Background="{DynamicResource ThemeWindowBg}"
                CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Main Container -->
        <Border Background="{DynamicResource ThemeWindowBg}"
                BorderBrush="{DynamicResource ThemeWindowBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,7"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                RenderOptions.ClearTypeHint="Enabled">
            <StackPanel Orientation="Vertical">
                <!-- Top Main Bar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Count Pill Badge -->
                    <Border Background="#0078D7" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"
                                  Fill="White"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0"/>
                            <TextBlock x:Name="BadgeTextBlock"
                                       Text="已暂存 1 处区域"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <!-- Guide Tip Text -->
                    <TextBlock x:Name="TipTextBlock"
                               Text="切换至目标界面后按快捷键或点击此处继续框选"
                               Foreground="{DynamicResource ThemeSubText}"
                               FontSize="12"
                               FontWeight="Normal"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <!-- Manage and Preview Toggle Button -->
                    <ToggleButton x:Name="ManageToggleButton"
                                  Content="预览已框选"
                                  Style="{StaticResource ModernToggleButton}"
                                  Click="ManageToggleButton_Click"
                                  Margin="0,0,6,0"/>

                    <!-- Undo Button -->
                    <Button x:Name="UndoButton"
                            Content="撤销"
                            Style="{StaticResource ModernButton}"
                            Click="UndoButton_Click"
                            Margin="0,0,6,0"
                            ToolTip="撤销最近的删除或调序操作 (Ctrl+Z)"/>

                    <!-- Continue Button -->
                    <Button x:Name="ContinueButton"
                            Content="继续框选"
                            Style="{StaticResource ModernButton}"
                            Click="ContinueButton_Click"
                            Margin="0,0,6,0"/>

                    <!-- Done Button -->
                    <Button x:Name="DoneButton"
                            Content="完成"
                            Style="{StaticResource PrimaryButton}"
                            Click="DoneButton_Click"
                            Margin="0,0,6,0"/>

                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                            Content="✕"
                            Click="CancelButton_Click"
                            IsCancel="True"
                            Background="Transparent"
                            Foreground="{DynamicResource ThemeSubText}"
                            BorderThickness="0"
                            Padding="8,4"
                            FontSize="12"
                            FontFamily="Microsoft YaHei UI, Segoe UI"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="xBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="xBorder" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Management & Image Thumbnails Dropdown List Panel -->
                <Grid x:Name="ManagementPanel" Visibility="Collapsed" Margin="0,10,0,2">
                    <Border Background="{DynamicResource ThemeInputBg}" 
                            BorderBrush="{DynamicResource ThemeInputBorder}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="8,6">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="已框选的图文片段（支持调序与删除，点击上方按钮可隐藏预览）：" 
                                       Foreground="{DynamicResource ThemeSubText}" 
                                       FontSize="11.5" 
                                       FontFamily="Microsoft YaHei UI, Segoe UI" 
                                       Margin="2,2,0,8"/>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="StagedItemsContainer" Orientation="Vertical"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
