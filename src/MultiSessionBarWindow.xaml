<Window x:Class="PixOcrSearch.MultiSessionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">
    <Border Background="#252528"
            BorderBrush="#4C4C52"
            BorderThickness="1"
            CornerRadius="18"
            Padding="14,7"
            Margin="10"
            Effect="{DynamicResource ShadowEffect}">
        <Border.Resources>
            <DropShadowEffect x:Key="ShadowEffect" BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Resources>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Count Pill Badge -->
            <Border Background="#0078D7" CornerRadius="12" Padding="9,4" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"
                          Fill="White"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,5,0"/>
                    <TextBlock x:Name="BadgeTextBlock"
                               Text="已暂存 1 处区域"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI, Microsoft YaHei UI"/>
                </StackPanel>
            </Border>

            <!-- Guide Tip Text -->
            <TextBlock x:Name="TipTextBlock"
                       Text="切换至目标界面后按 Alt+W 或点击此处继续框选"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="Normal"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"/>

            <!-- Continue Button -->
            <Button x:Name="ContinueButton"
                    Content="➕ 继续框选"
                    Click="ContinueButton_Click"
                    Background="#36363B"
                    Foreground="#FFFFFF"
                    BorderBrush="#54545C"
                    BorderThickness="1"
                    Padding="11,4"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="cBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cBorder" Property="Background" Value="#484850"/>
                                            <Setter TargetName="cBorder" Property="BorderBrush" Value="#666670"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="cBorder" Property="Background" Value="#222226"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Done Button -->
            <Button x:Name="DoneButton"
                    Content="✓ 完成"
                    Click="DoneButton_Click"
                    IsDefault="True"
                    Background="#0078D7"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Padding="14,4"
                    FontSize="11.5"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="dBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="dBorder" Property="Background" Value="#1C86EE"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="dBorder" Property="Background" Value="#0066B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Cancel Button -->
            <Button x:Name="CancelButton"
                    Content="✕"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Background="Transparent"
                    Foreground="#B0B0B8"
                    BorderThickness="0"
                    Padding="8,4"
                    FontSize="12"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="xBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="xBorder" Property="Background" Value="#33FFFFFF"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>
