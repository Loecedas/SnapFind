<Window x:Class="PixOcrSearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource ThemeWindowBg}"
        Topmost="False"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/app.ico"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern flat buttons using DynamicResource -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084E3"/>
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom clean ComboBox Template to avoid system high-contrast theme issues -->
        <ControlTemplate x:Key="ThemeComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Name="ToggleButton" 
                              BorderBrush="{TemplateBinding BorderBrush}" 
                              Background="{TemplateBinding Background}" 
                              Foreground="{TemplateBinding Foreground}" 
                              Focusable="false"
                              IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Name="Border" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <Path Name="Arrow" Grid.Column="1" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border Name="DropDownBorder" Background="{DynamicResource ThemeWindowBg}" BorderBrush="{DynamicResource ThemeWindowBorder}" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="false">
                    <Setter TargetName="DropDownBorder" Property="MinHeight" Value="50"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBg}"
            BorderBrush="{DynamicResource ThemeWindowBorder}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" Cursor="SizeAll">
                <TextBlock Text="SnapFind 设置" 
                            Foreground="{DynamicResource ThemeText}" 
                            FontSize="13" 
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="3">
                                    <Path x:Name="path" 
                                          Data="M 0,0 L 10,0" 
                                          Stroke="{DynamicResource ThemeSubText}" 
                                          StrokeThickness="1" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                        <Setter TargetName="path" Property="Stroke" Value="{DynamicResource ThemeText}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="CancelButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Width="28"
                            Height="28"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="3">
                                    <Path x:Name="path" 
                                          Data="M 0,0 L 8,8 M 0,8 L 8,0" 
                                          Stroke="{DynamicResource ThemeSubText}" 
                                          StrokeThickness="1" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                        <Setter TargetName="path" Property="Stroke" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1">
                <!-- Search Engine Section -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="搜索引擎" 
                               Foreground="{DynamicResource ThemeSubText}" 
                               FontSize="11" 
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="SearchEngineComboBox"
                              Background="{DynamicResource ThemeInputBg}"
                              Foreground="{DynamicResource ThemeInputFg}"
                              BorderBrush="{DynamicResource ThemeInputBorder}"
                              BorderThickness="1"
                              Padding="6"
                              FontSize="12"
                              FontFamily="Segoe UI, Microsoft YaHei UI"
                              Template="{StaticResource ThemeComboBoxTemplate}">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="{DynamicResource ThemeWindowBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeInputFg}"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0078D7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBoxItem Content="谷歌 (Google)" Tag="https://www.google.com/search?q="/>
                        <ComboBoxItem Content="必应 (Bing)" Tag="https://www.bing.com/search?q="/>
                    </ComboBox>
                </StackPanel>

                <!-- OCR Model Section -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="OCR 识别模型" 
                               Foreground="{DynamicResource ThemeSubText}" 
                               FontSize="11" 
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="OcrModelComboBox"
                              Background="{DynamicResource ThemeInputBg}"
                              Foreground="{DynamicResource ThemeInputFg}"
                              BorderBrush="{DynamicResource ThemeInputBorder}"
                              BorderThickness="1"
                              Padding="6"
                              FontSize="12"
                              FontFamily="Segoe UI, Microsoft YaHei UI"
                              Template="{StaticResource ThemeComboBoxTemplate}">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="{DynamicResource ThemeWindowBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeInputFg}"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0078D7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBoxItem Content="PP-OCRv6 (轻量版 - 速度最快)" Tag="PP-OCRv6_tiny"/>
                        <ComboBoxItem Content="PP-OCRv6 (标准版 - 准确率高)" Tag="PP-OCRv6_small"/>
                    </ComboBox>
                </StackPanel>

                <!-- Hotkey Section -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="全局截图快捷键 (点击文本框后直接按键盘设置)" 
                               Foreground="{DynamicResource ThemeSubText}" 
                               FontSize="11" 
                               Margin="0,4,0,4"/>
                    <TextBox x:Name="HotkeyTextBox"
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource ThemeInputFg}"
                             BorderBrush="{DynamicResource ThemeInputBorder}"
                             BorderThickness="1"
                             Padding="6"
                             FontSize="12"
                             IsReadOnly="True"
                             Cursor="Hand"
                             Text="Control,Alt + S"
                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                </StackPanel>

                <!-- Auto Start -->
                <CheckBox x:Name="AutoStartCheckBox"
                          Content="开机自动启动"
                          Foreground="{DynamicResource ThemeText}"
                          FontSize="12"
                          VerticalContentAlignment="Center"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                <Button Content="取消" 
                        Click="CancelButton_Click"
                        Style="{StaticResource ModernButton}" 
                        Margin="0,0,8,0"/>
                <Button Content="保存" 
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
