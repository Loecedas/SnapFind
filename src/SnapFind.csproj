<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>2.5.0</Version>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
      <BaseIntermediateOutputPath>obj\SnapFind\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\SnapFind\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PaddleOCRSharp" Version="6.2.0" />
    <ProjectReference Include="SnapFind.Plugin.Abstractions\SnapFind.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Plugins\**;SnapFind.Plugin.Abstractions\**" />
    <Page Remove="Plugins\**;SnapFind.Plugin.Abstractions\**" />
    <Resource Remove="Plugins\**;SnapFind.Plugin.Abstractions\**" />
    <None Remove="Plugins\**;SnapFind.Plugin.Abstractions\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\libs\**\*" Exclude="..\libs\rapid\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libs\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="about_logo.jpg" />
  </ItemGroup>

</Project>


