<Application x:Class="PixOcrSearch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixOcrSearch"
             Startup="Application_Startup">
    <Application.Resources>
        <!-- Default theme color fallbacks -->
        <SolidColorBrush x:Key="ThemeWindowBg" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="ThemeWindowBorder" Color="#D2D2D2"/>
        <SolidColorBrush x:Key="ThemeText" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeSubText" Color="#666666"/>
        <SolidColorBrush x:Key="ThemeInputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeInputFg" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeInputBorder" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ThemeBtnBg" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="ThemeBtnFg" Color="#000000"/>
        <SolidColorBrush x:Key="ThemeBtnBorder" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ThemeHoverBg" Color="#E6E6E6"/>
    </Application.Resources>
</Application>
