<Window x:Class="PixOcrSearch.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource ThemeWindowBg}"
        Topmost="False"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/app.ico"
        SizeToContent="Height"
        Width="450"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Flat, modern hover styles for buttons using DynamicResource -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084E3"/>
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBg}"
            BorderBrush="#0078D7"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header (Title and Close Icon) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" Cursor="SizeAll">
                <TextBlock Text="OCR 识别结果" 
                            Foreground="{DynamicResource ThemeSubText}" 
                            FontSize="10" 
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="3">
                                    <Path x:Name="path" 
                                          Data="M 0,0 L 10,0" 
                                          Stroke="{DynamicResource ThemeSubText}" 
                                          StrokeThickness="1" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                                        <Setter TargetName="path" Property="Stroke" Value="{DynamicResource ThemeText}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Width="28"
                            Height="28"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="3">
                                    <Path x:Name="path" 
                                          Data="M 0,0 L 8,8 M 0,8 L 8,0" 
                                          Stroke="{DynamicResource ThemeSubText}" 
                                          StrokeThickness="1" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                        <Setter TargetName="path" Property="Stroke" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Editable Text Box -->
            <TextBox x:Name="OcrTextBox"
                     Grid.Row="1"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="{DynamicResource ThemeInputBg}"
                     Foreground="{DynamicResource ThemeInputFg}"
                     BorderBrush="{DynamicResource ThemeInputBorder}"
                     BorderThickness="1"
                     Padding="6"
                     FontSize="13"
                     FontFamily="Segoe UI, Microsoft YaHei UI"
                     CaretBrush="{DynamicResource ThemeText}"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="OcrTextBox_PreviewKeyDown"/>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Button Content="设置" 
                        Click="SettingsButton_Click"
                        Style="{StaticResource ModernButton}" 
                        HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制" 
                            Click="CopyButton_Click"
                            Style="{StaticResource ModernButton}" 
                            Margin="0,0,8,0"/>
                    <Button Content="搜索" 
                            Click="SearchButton_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
