<Window x:Class="PixOcrSearch.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="450"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Flat, modern hover styles for buttons using DynamicResource -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHoverBg}"/>
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084E3"/>
                    <Setter Property="BorderBrush" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBg}"
            BorderBrush="#0078D7"
            BorderThickness="1"
            CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header (Title and Close Icon) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" Cursor="SizeAll">
                <TextBlock Text="OCR 识别结果" 
                           Foreground="{DynamicResource ThemeSubText}" 
                           FontSize="10" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Content="✕" 
                        Click="CloseButton_Click"
                        Foreground="{DynamicResource ThemeSubText}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontSize="10"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Editable Text Box -->
            <TextBox x:Name="OcrTextBox"
                     Grid.Row="1"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="{DynamicResource ThemeInputBg}"
                     Foreground="{DynamicResource ThemeInputFg}"
                     BorderBrush="{DynamicResource ThemeInputBorder}"
                     BorderThickness="1"
                     Padding="6"
                     FontSize="13"
                     FontFamily="Segoe UI, Microsoft YaHei UI"
                     CaretBrush="{DynamicResource ThemeText}"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="OcrTextBox_PreviewKeyDown"/>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,10,0,0">
                <Button Content="📋 复制" 
                        Click="CopyButton_Click"
                        Style="{StaticResource ModernButton}" 
                        Margin="0,0,8,0"/>
                <Button Content="🔍 搜索" 
                        Click="SearchButton_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
